## PORT SERVER
quarkus.http.port=8081

## DB COCKROACHDB
quarkus.datasource.db-kind=postgresql
quarkus.datasource.username=zw
quarkus.datasource.password=123456
quarkus.datasource.jdbc.url=jdbc:postgresql://localhost:26257/test1?useSSL=false&serverTimezone=UTC&useLegacyDatetimeCode=false
quarkus.datasource.jdbc.max-size=16
quarkus.hibernate-orm.database.generation=none

## Open API SWAGGER
quarkus.smallrye-openapi.path=/swagger
quarkus.swagger-ui.always-include=true
quarkus.swagger-ui.path=/swagger-ui.html

## JWT
mp.jwt.verify.publickey.location=certs/publickey.pem
smallrye.jwt.sign.key.location=certs/privatekey.pem
smallrye.jwt.always-check-authorization=true

## Redis
quarkus.redisson.single-server-config.address=redis://localhost:6379
quarkus.redisson.single-server-config.password=123456
quarkus.redisson.single-server-config.database=1
quarkus.redisson.threads=16
quarkus.redisson.netty-threads=32

## docker
quarkus.container-image.build=true  
quarkus.container-image.group=io.zw
quarkus.container-image.name=auth
quarkus.container-image.tag=latest
quarkus.jib.ports=8080